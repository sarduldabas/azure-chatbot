# =====================================================================
#  Copy this file to ".env" and fill it in.  ".env" is git-ignored -
#  never commit real credentials.  Used by docker-compose and infra/*.
# =====================================================================

# ---- Azure AI Foundry (URLs) -----------------------------------------
# Foundry portal -> your project -> Overview -> "Project endpoint"
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# Name of the agent in Foundry that the chatbot should talk to
FOUNDRY_AGENT_NAME=my-agent
# Only used by infra/create_agent.py (name of a model deployment in your project)
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini

# ---- Credentials for LOCAL docker-compose only ------------------------
# A service principal that has the "Azure AI User" role on the Foundry resource.
# (Create one with the command in README.md.)  In Azure these stay unused:
# the backend authenticates with a managed identity, no secrets involved.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---- Azure deployment settings (used by infra/provision.sh) ------------
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-chatbot
# Globally unique, 5-50 chars, lowercase letters and digits only
AZURE_ACR_NAME=
AZURE_CONTAINERAPPS_ENV=cae-chatbot
# GitHub repo that runs the pipeline, e.g. sardul/azure-chatbot
GITHUB_REPO=
